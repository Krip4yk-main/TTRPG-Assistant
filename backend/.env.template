# Скопіюйте у backend/.env і заповніть. Реальні значення не комітимо.

# development | test | production
NODE_ENV=development
PORT=3000
# Публічний URL фронту (для OAuth callback і OG). Локально: http://localhost:4200
PUBLIC_BASE_URL=http://localhost:4200

# Середовище розгортання: local (за замовчуванням, машина розробника) | dev (окремий тестовий
# сервер) | prod. Для dev/prod обов'язкові NODE_ENV=production і https PUBLIC_BASE_URL.
# У docker compose перекривається значенням DEPLOY_ENV з кореневого env-файлу.
# На dev: свій TELEGRAM_BOT_TOKEN (тестовий бот), свої GOOGLE_*/DISCORD_* з redirect URI dev-домену,
# свій CALENDAR_IMPORT_KEY і INTERNAL_API_KEY — нічого не спільного з production.
DEPLOY_ENV=local

# MySQL: user/password з кореневого .env (docker compose), бази nri та nri_test.
# Формат: mysql://nri:<password>@localhost:3306/nri (тест: .../nri_test — тести створюють nri_test_1…4 поруч)
DATABASE_URL=
DATABASE_URL_TEST=
# Redis (локально з docker compose): redis://localhost:6379
REDIS_URL=
# Необов'язково: префікс каналів Redis-адаптера Socket.IO (однаковий для всіх екземплярів; за замовчуванням socket.io)
REALTIME_ADAPTER_KEY=
SESSION_TTL_DAYS=30

# Мінімум 32 символи. Згенерувати: openssl rand -base64 32
# НІКОЛИ не змінювати після запуску: ротація анулює всі надгробки ідентичностей
# (зокрема бани видалених акаунтів — вони знову зможуть зареєструватися).
IDENTITY_PEPPER=

# Telegram: токен — BotFather -> /newbot; username бота без @
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_LOGIN_MAX_AGE_SEC=86400
# Числовий Telegram id власника платформи (не username). Дізнатися: написати боту @userinfobot
# (перевірте, що бот ще працює) або будь-якому подібному. Хто першим увійде через Telegram-віджет
# на сайті (або прив'яже його) з цим id, стане власником — лише якщо власника ще немає, і лише раз.
# Порожньо — вимкнено. Докладно: docs/ops/deploy.md
OWNER_TELEGRAM_ID=

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (тип Web),
# redirect URI: ${PUBLIC_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord Developer Portal -> Applications -> New Application -> OAuth2: Client ID і Client Secret,
# Redirects: ${PUBLIC_BASE_URL}/api/auth/discord/callback (scope identify). Порожньо — вхід через
# Discord вимкнено (ендпоінти /api/auth/discord/* відповідають NOT_FOUND).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Ключ, спільний із ботом; мінімум 32 символи (openssl rand -base64 32)
INTERNAL_API_KEY=

# Імпорт календаря з iCal-посилання: ключ шифрування посилань (AES-256-GCM), base64 рівно
# 32 байтів — згенерувати: openssl rand -base64 32. Порожньо — імпорт вимкнено (API відповідає
# CALENDAR_IMPORT_DISABLED); посилання у відкритому вигляді не зберігаються ніколи.
# Ротація: новий ключ — у CALENDAR_IMPORT_KEY, старий — у CALENDAR_IMPORT_KEY_PREVIOUS (лише
# розшифрування); кожне посилання перешифровується новим ключем на наступній успішній
# синхронізації (автоматично — протягом ~3 год). Після цього PREVIOUS можна прибрати.
# Без PREVIOUS зміна ключа робить збережені посилання нечитабельними: імпорти «зламаються»,
# користувачам доведеться зберегти посилання знову.
CALENDAR_IMPORT_KEY=
CALENDAR_IMPORT_KEY_PREVIOUS=

# Лише для локальної розробки
# Лише локальна розробка (NODE_ENV=development, TRUST_PROXY=0). У production — false/не задавати.
# Reverse proxy на тому ж хості робить усі запити «локальними» і обходить перевірку localhost.
DEV_LOGIN_ENABLED=false
DEV_OWNER_KEY=

# Лише бета (DEPLOY_ENV=dev): dev-вхід за кодом тестера на прихованому /login/dev.
# Потрібні DEV_LOGIN_ENABLED=true і TRUST_PROXY>=1; DEV_OWNER_KEY на беті не діє.
# Формат: мітка:код,мітка:код. Код: base64url/hex без ':' і ',', >=24 символи (`openssl rand -hex 16`).
# Відкликати код: прибрати запис і перезапустити бекенд. У проді (DEPLOY_ENV=prod) НЕ задавати:
# бекенд не стартує. Докладно: docs/ops/environments.md
# DEV_LOGIN_CODES=olena:<код>,petro:<код>

# Кількість проксі перед сервером у prod (0 локально)
TRUST_PROXY=0

# Ліміти запитів (за замовчуванням 300 / 20 на 300 с)
RATE_LIMIT_WINDOW_SEC=300
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20
