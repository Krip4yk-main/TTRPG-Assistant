# Змінні Telegram-бота. Скопіюйте цей файл у `bot/.env` й заповніть значення.
# `.env` не комітиться.

# Токен бота. Що це: секрет, яким бот авторизується в Telegram Bot API.
# Де взяти: у Telegram напишіть @BotFather -> /newbot (або /token для наявного бота).
TELEGRAM_BOT_TOKEN=

# Адреса внутрішнього API бекенда (з префіксом /api/internal, без слеша в кінці).
# Що це: куди бот надсилає запити (прив'язка акаунта тощо).
# Де взяти: локально — http://localhost:3000/api/internal; у docker — ім'я сервісу бекенда.
BACKEND_INTERNAL_URL=http://localhost:3000/api/internal

# Спільний ключ бота й бекенда (заголовок X-Internal-Key).
# Що це: пароль, яким бекенд впізнає виклики від бота.
# Де взяти: має ДОСЛІВНО збігатися з INTERNAL_API_KEY у backend/.env;
# згенерувати новий: `openssl rand -base64 32` (і вписати в обидва файли).
INTERNAL_API_KEY=

# Публічна адреса сайту (фронтенду), без слеша в кінці.
# Що це: база для посилань «Детальніше: …» у Telegram-сповіщеннях.
# Де взяти: локально — http://localhost:4200 (за замовчуванням); у продакшені — домен сайту
# (той самий, що PUBLIC_BASE_URL у backend/.env); у production (NODE_ENV=production) обов'язкова.
PUBLIC_BASE_URL=http://localhost:4200
