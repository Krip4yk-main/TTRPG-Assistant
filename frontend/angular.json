{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "less",
          "changeDetection": "OnPush"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "nri",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "less",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "src/styles.less",
              {
                "input": "src/app/theming/themes/quest-board/quest-board.less",
                "bundleName": "theme-quest-board",
                "inject": false
              },
              {
                "input": "src/app/theming/themes/quest-board/quest-board-material.scss",
                "bundleName": "theme-quest-board",
                "inject": false
              },
              {
                "input": "src/app/theming/themes/neon-signs/neon-signs.less",
                "bundleName": "theme-neon-signs",
                "inject": false
              },
              {
                "input": "src/app/theming/themes/neon-signs/neon-signs-material.scss",
                "bundleName": "theme-neon-signs",
                "inject": false
              },
              {
                "input": "src/app/theming/themes/holo-market/holo-market.less",
                "bundleName": "theme-holo-market",
                "inject": false
              },
              {
                "input": "src/app/theming/themes/holo-market/holo-market-material.scss",
                "bundleName": "theme-holo-market",
                "inject": false
              },
              {
                "input": "src/app/theming/themes/night-city/night-city.less",
                "bundleName": "theme-night-city",
                "inject": false
              },
              {
                "input": "src/app/theming/themes/night-city/night-city-material.scss",
                "bundleName": "theme-night-city",
                "inject": false
              }
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kB",
                  "maximumError": "1.2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
