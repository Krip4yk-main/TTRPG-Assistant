# Налаштування фронтенду на етапі збірки (НЕ секрети — потрапляють у публічний JS-бандл).
# Скопіюйте у frontend/.env. Перед `npm start` / `npm run build` / `npm test`
# скрипт scripts/gen-runtime-config.mjs генерує з них src/environments/runtime-config.ts.
# Змінні середовища процесу (наприклад, у CI/Docker) мають пріоритет над .env.

# Ім'я Telegram-бота й увімкнені Google/Discord фронтенд бере під час запуску з бекенду
# (GET /api/public-config; з backend/.env) — у збірці їх задавати не треба.

# "true" — показати форму dev-входу на сторінці /login (лише для локальної розробки;
# бекенд додатково вимагає DEV_LOGIN_ENABLED=true і локальну адресу). На беті (NG_APP_DEPLOY_ENV=dev)
# `true` вшиває прихований маршрут /login/dev (вхід за кодом тестера). У продакшні — порожньо.
NG_APP_DEV_LOGIN=

# Середовище розгортання: `dev` — на dev-сервері показується банер «Тестове середовище»;
# `local`/`prod`/порожньо — без банера. У Docker-збірці передається build-аргументом
# NG_APP_DEPLOY_ENV (docker-compose.prod.yml бере його з DEPLOY_ENV кореневого env-файлу).
NG_APP_DEPLOY_ENV=
