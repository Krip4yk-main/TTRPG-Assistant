# Налаштування фронтенду на етапі збірки (НЕ секрети — потрапляють у публічний JS-бандл).
# Скопіюйте у frontend/.env. Перед `npm start` / `npm run build` / `npm test`
# скрипт scripts/gen-runtime-config.mjs генерує з них src/environments/runtime-config.ts.
# Змінні середовища процесу (наприклад, у CI/Docker) мають пріоритет над .env.

# Ім'я Telegram-бота без "@" (те саме, що TELEGRAM_BOT_USERNAME у backend/.env).
# Береться в @BotFather. Порожньо — віджет «Увійти через Telegram» не показується.
NG_APP_TELEGRAM_BOT_USERNAME=

# "true" — показати кнопки «Увійти через Google» і «Прив'язати Google». Вмикайте лише коли
# на бекенді задано GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET (інакше OAuth-старт поверне помилку).
NG_APP_GOOGLE_LOGIN=

# "true" — показати кнопки «Увійти через Discord» і «Прив'язати Discord». Вмикайте лише коли
# на бекенді задано DISCORD_CLIENT_ID / DISCORD_CLIENT_SECRET (інакше OAuth-старт поверне помилку).
NG_APP_DISCORD_LOGIN=

# "true" — показати форму dev-входу на сторінці /login (лише для локальної розробки;
# бекенд додатково вимагає DEV_LOGIN_ENABLED=true і локальну адресу). У продакшні — порожньо.
NG_APP_DEV_LOGIN=
