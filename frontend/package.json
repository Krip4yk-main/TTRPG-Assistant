{
  "name": "@nri/frontend",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "config": "node scripts/gen-runtime-config.mjs",
    "prestart": "npm run config",
    "start": "ng serve",
    "dev": "npm run start",
    "prebuild": "npm run config",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run config",
    "test": "ng test --watch=false",
    "typecheck": "npm run config && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "~22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/material": "~22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@material-symbols/font-400": "^0.49.0",
    "@ngx-translate/core": "^18.1.0",
    "@ngx-translate/http-loader": "^18.1.0",
    "@nri/shared": "*",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "jsdom": "^31.0.0",
    "less": "^4.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
