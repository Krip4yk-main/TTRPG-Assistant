# Змінні для docker-compose (MySQL). Скопіюйте цей файл у `.env` у корені
# репозиторію й задайте власні значення. `.env` не комітиться.

# Пароль root-користувача MySQL (лише для локальної розробки).
MYSQL_ROOT_PASSWORD=change_me_root
# Користувач застосунку; init-скрипт дає йому права на БД `nri` та `nri_test`.
# Важливо: init-скрипт містить ім'я користувача `nri` — не змінюйте його без правки docker/mysql-init.sql.
MYSQL_USER=nri
# Пароль користувача застосунку.
MYSQL_PASSWORD=change_me
