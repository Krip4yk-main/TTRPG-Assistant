# Змінні для docker-compose (MySQL). Скопіюйте цей файл у `.env` у корені
# репозиторію й заповніть значення. `.env` не комітиться.

# Пароль root-користувача MySQL (лише для локальної розробки).
# Придумайте будь-який надійний пароль; згенерувати: `openssl rand -base64 24`.
MYSQL_ROOT_PASSWORD=

# Користувач застосунку; init-скрипт дає йому права на БД `nri` та `nri_test`.
# Вкажіть `nri` — це ім'я захардкоджене в docker/mysql-init.sql (змінюйте лише разом із ним).
MYSQL_USER=

# Пароль користувача застосунку.
# Придумайте будь-який надійний пароль; згенерувати: `openssl rand -base64 24`.
MYSQL_PASSWORD=

# --- Бекапи БД (лише production, сервіс `backup`; див. docs/ops/backups.md) ---
# Користувач MySQL для бекапу (не root; гранти — у docs/ops/backups.md). За замовчуванням `backup`.
BACKUP_DB_USER=
# Пароль користувача бекапу (без символів `"`, `\` і переносу рядка).
BACKUP_DB_PASSWORD=
# Необов'язково, типові значення (розкоментуйте, щоб змінити):
# BACKUP_ENABLED=true
# У кластері BACKUP_DB_HOST — ім'я сервісу MySQL. На беті можна BACKUP_ENABLED=false, якщо бекапи там не потрібні.
# BACKUP_DB_HOST=mysql
# BACKUP_DB_PORT=3306
# BACKUP_DB_NAME=nri
# Парольна фраза шифрування бекапів (AES-256). Без неї бекап не робиться.
# Зберігайте копію поза сервером: без неї бекапи не розшифрувати. `openssl rand -base64 32`.
BACKUP_PASSPHRASE=
# Копія поза сервером (Cloudflare R2 або Backblaze B2, S3-API). Порожні — лише локально.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Необов'язково: регіон (R2 — `auto`, B2 — напр. `eu-central-003`).
BACKUP_S3_REGION=
