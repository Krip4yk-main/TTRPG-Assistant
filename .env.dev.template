# Кореневий env-файл docker compose для dev-сервера. Скопіюйте у `.env.dev` і заповніть.
# Файл НЕ комітиться (є в .gitignore). Запуск:
#   docker compose --env-file .env.dev -f docker-compose.prod.yml up -d
# Докладно: docs/ops/environments.md
#
# УВАГА: усі значення тут і в backend/.env та bot/.env — окремі від production: свої БД, Redis, ТЕСТОВИЙ Telegram-бот
# (інший токен у BotFather), окремі OAuth-застосунки Google/Discord з redirect URI dev-домену,
# свій CALENDAR_IMPORT_KEY. Не копіюйте токени й ключі з production.

# Середовище розгортання: local | dev | prod. Передається бекенду, фронтенду (банер, noindex).
DEPLOY_ENV=dev

# --- MySQL (власна БД цього сервера) ---
# Пароль root; згенерувати: `openssl rand -base64 24`.
MYSQL_ROOT_PASSWORD=
# Користувач застосунку (у БД `nri`).
MYSQL_USER=nri
# Пароль користувача (без символів `@ : / ? #`, бо він потрапляє в DATABASE_URL).
MYSQL_PASSWORD=

# --- Налаштування фронтенду (вшиваються на збірці; не секрети) ---
# Ім'я ТЕСТОВОГО Telegram-бота без `@` (те саме, що TELEGRAM_BOT_USERNAME у backend/.env).
NG_APP_TELEGRAM_BOT_USERNAME=
# `true` — показати вхід через Google/Discord (лише коли на бекенді задано відповідні ключі).
NG_APP_GOOGLE_LOGIN=
NG_APP_DISCORD_LOGIN=
# `true` — на беті вшити прихований маршрут /login/dev (dev-вхід за кодом тестера). Потрібен разом із
# DEV_LOGIN_ENABLED=true і DEV_LOGIN_CODES у backend/.env. Без нього — порожньо/false. Не секрет.
# Після зміни перебудуйте фронтенд (`build frontend`). Докладно: docs/ops/environments.md
NG_APP_DEV_LOGIN=
# Нагадування для backend/.env беті: TRUST_PROXY >= 1 (інакше спільний ліміт спроб для всіх тестерів);
# DEV_LOGIN_CODES=мітка:код,... (код: `openssl rand -hex 16`) не зберігайте в цьому файлі.

# --- Бекапи БД (див. docs/ops/backups.md) ---
BACKUP_ENABLED=false
# На dev бекапи вимкнено (сервіс backup простоює). Щоб увімкнути — BACKUP_ENABLED=true і заповніть:
# Користувач MySQL для бекапу (за замовчуванням `backup`) і його пароль (без `"`, `\` і переносу рядка).
BACKUP_DB_USER=
BACKUP_DB_PASSWORD=
# Парольна фраза шифрування бекапів (AES-256); копію зберігайте поза сервером. `openssl rand -base64 32`.
BACKUP_PASSPHRASE=
# Копія поза сервером (Cloudflare R2 / Backblaze B2). Порожні — лише локально.
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=

# Нагадування для backend/.env: OWNER_TELEGRAM_ID=<ваш числовий Telegram id> — вхід через Telegram на сайті
# з цим id робить вас власником (якщо власника ще немає). Не секрет, але задається в backend/.env,
# не тут. Докладно: docs/ops/deploy.md
